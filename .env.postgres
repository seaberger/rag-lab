# PostgreSQL credentials for RAG Lab
# Source this file before running migration:
#   source .env.postgres

# For development, using a default password
# Change this for production!
export POSTGRES_PASSWORD=rag_dev_password  # pragma: allowlist secret
export POSTGRES_HOST=localhost
export POSTGRES_PORT=5432
export POSTGRES_DB=rag_lab
export POSTGRES_USER=rag_user

# Optional: Qdrant server API key if using authentication
# export QDRANT_API_KEY=your_qdrant_key_here
