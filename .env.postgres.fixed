# PostgreSQL credentials for RAG Lab - Fixed version
# Source this file before running PostgreSQL commands:
#   source .env.postgres.fixed

# These match what PipelineConfig expects
export POSTGRES_PASSWORD=rag_dev_password  # pragma: allowlist secret
export POSTGRES_HOST=localhost
export POSTGRES_PORT=5432
export POSTGRES_DB=rag_lab_db  # Fixed: was rag_lab
export POSTGRES_USER=rag_lab_user  # Fixed: was rag_user

# Also set PGPASSWORD for psql commands
export PGPASSWORD=rag_dev_password  # pragma: allowlist secret
